# Copy to "<instance>.env" (e.g. eric.env) for ./icloud-photo-sync.sh <instance> AUTH|SYNC
# Do not commit real instance env files (see .gitignore).

# Required
ICLOUD_USERNAME=your@email.com
ICLOUD_PASSWORD=your_password

# Optional: download root (default: ./data under your shell's cwd when you run the script)
# DATA_FOLDER=/mnt/raid

# Optional: cookie mount on host (default: ./cookies under cwd)
# COOKIE_FOLDER=/custom/path/to/cookies

TZ=America/Los_Angeles

# Optional: omit to use defaults (36000 seconds, 500). Set to override.
# INTERVAL=36000
# UNTIL_FOUND=500
